{
  "contractsDir": "verify",
  "runner": "gotest",
  "gate": {
    "test": "go test -count=1 ./...",
    "lint": "go vet ./..."
  },
  "quality": {
    "forbidFocusedTests": true,
    "forbidSkippedTests": true,
    "forbidAssertionFreeTests": true,
    "forbidSuppressions": true,
    "forbidSwallowedErrors": true,
    "maxTodoMarkers": 0
  }
}
